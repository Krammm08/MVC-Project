@model WebApplication1.Models.PortfolioModel

@{
    ViewData["Title"] = Model.Name + "'s Portfolio";
}

<div class="portfolio-container container py-4">
    <!-- HERO HEADER -->
    <header class="portfolio-hero text-center mb-5 p-4">
        <h1 class="hero-title">@Model.Name</h1>
        <p class="hero-subtitle text-muted">@Model.Title</p>

        <a href="mailto:@Model.Email" class="hero-email d-inline-block mb-3">
            <i class="bi bi-envelope-fill"></i> @Model.Email
        </a>

        <div class="socmed-links d-flex justify-content-center gap-3 mt-2">
            <a href="https://linkedin.com/in/ralmonterey" target="_blank" rel="noopener noreferrer" class="social-btn btn-linkedin" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
            <a href="https://github.com/reindezvvous" target="_blank" rel="noopener noreferrer" class="social-btn btn-github" title="GitHub"><i class="bi bi-github"></i></a>
            <a href="https://solanosky.itch.io" target="_blank" rel="noopener noreferrer" class="social-btn btn-itch" title="Itch.io"><i class="bi bi-controller"></i></a>
            <a href="https://www.facebook.com/ralmonterey" target="_blank" rel="noopener noreferrer" class="social-btn btn-facebook" title="Facebook"><i class="bi bi-facebook"></i></a>
            <a href="https://instagram.com/desoliveu_" target="_blank" rel="noopener noreferrer" class="social-btn btn-instagram" title="Instagram"><i class="bi bi-instagram"></i></a>
        </div>
    </header>

    <!-- 1. PANATIKO -->
    <section class="portfolio-section mb-5">
        <h2 class="section-heading mb-4">./RECENT PROJECTS</h2>
        <div class="row g-4">
            @foreach (var project in Model.Projects)
            {
                <div class="col-12">
                    <article class="project-card p-4">
                        <div class="card-header d-flex gap-2 mb-2">
                            @foreach (var tag in project.Tags)
                            {
                                <span class="tag tag-primary">@tag</span>
                            }
                        </div>

                        <h3 class="project-title mb-2">@project.Title</h3>
                        <p class="project-desc mb-3">@project.Description</p>

                        @if (!string.IsNullOrEmpty(project.Goal))
                        {
                            <p class="mb-3"><strong>GOAL:</strong> @project.Goal</p>
                        }

                        <div class="subtags d-flex gap-2 mb-3">
                            @foreach (var subtag in project.SubTags)
                            {
                                <span class="subtag">@subtag</span>
                            }
                        </div>

                        @if (project.Details.Any())
                        {
                            <ul class="subtext-bullets mb-3 ps-3">
                                @foreach (var detail in project.Details)
                                {
                                    <li><small>@detail</small></li>
                                }
                            </ul>
                        }

                        <div class="card-footer-action mt-3">
                            <a href="@project.Repo" target="_blank" rel="noopener noreferrer" class="btn @project.ButtonClass btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> @project.ButtonText
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>

    <!-- 2. EXPERIENCE -->
    <section class="portfolio-section mb-5">
        <h2 class="section-heading mb-4">./EXPERIENCE</h2>
        <div class="row g-4">
            @foreach (var exp in Model.Experiences)
            {
                <div class="col-md-4">
                    <div class="skill-box p-4 h-100">
                        <span class="tag tag-primary float-end">@exp.Period</span>
                        <h4 class="mb-1">@exp.Role</h4>
                        <p class="text-muted mb-0" style="font-size: 0.9rem;">@exp.Organization</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 3. SKILLS & TOOLS -->
    <section class="portfolio-section mb-5">
        <h2 class="section-heading mb-4">./SKILLS-and-TOOLS</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="skill-box p-4 h-100">
                    <h3 class="mb-3"><i class="bi bi-code-slash me-2"></i> Tech Stack</h3>
                    <div class="badge-list d-flex flex-wrap gap-2">
                        @foreach (var tech in Model.TechStack)
                        {
                            <span class="@tech.ToolClass"><i class="bi @tech.IconClass me-1"></i> @tech.Name</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="skill-box p-4 h-100">
                    <h3 class="mb-3"><i class="bi bi-palette me-2"></i> Design Stack</h3>
                    <div class="badge-list d-flex flex-wrap gap-2">
                        @foreach (var design in Model.DesignStack)
                        {
                            <span class="@design.ToolClass"><i class="bi @design.IconClass me-1"></i> @design.Name</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

 <!-- 4. INTERESTS -->
<section class="portfolio-section mb-5">
    <h2 class="section-heading mb-4">./INTERESTS</h2>
    <div class="interests-dropdown-list d-flex flex-column gap-3">
        @foreach (var interest in Model.Interests)
        {
            <details class="interest-dropdown border-bottom pb-2">
                <summary class="fw-bold d-flex justify-content-between align-items-center py-2">
                    <span class="interest-title">@interest.Title</span>
                    <span class="interest-tag ms-2">@interest.Tag</span>
                </summary>
                <p class="interest-desc mt-2 mb-1">
                    @interest.Description
                </p>
            </details>
        }
    </div>
</section>
</div>