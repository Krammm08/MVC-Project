@model WebApplication1.Models.Portfolio
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Myportfolio.css" />
    <title>Document</title>
</head>

<body>
    <div class="grid-container">
        <div class="left-container">
            <img src="~/image/Mark.png" alt="Profile Image" />
            <p class="name">@Model.firstName @Model.lastName</p>
            <p class="description">Computer Science Student</p>
            <h1 class="header">Contacts:</h1>
            <ul>
                @for (int i = 0; i < Math.Min(Model.contacts.Count, Model.contactsImage.Count); i++)
                {
                    <img src="@Model.contactsImage[i]" alt="Contact" />
                    @Model.contacts[i]
                }
            </ul>
            <h1>Social Media:</h1>
            <ul>
                @for (int i = 0; i < Math.Min(Model.socials.Count, Model.socialsImage.Count); i++)
                {
                    <img src="@Model.socialsImage[i]" alt="Social Media" />
                    <a href="@Model.socials.Values.ElementAt(i)">@Model.socials.Keys.ElementAt(i)</a>
                }
            </ul>
        </div>
        <div class="right-container">
            <p>@Model.aboutMe</p>
            <H1>Education:</H1>
            <ul>
                @foreach (var education in Model.education)
                {
                    <li>@education</li>
                }
            </ul>
            <H1>Achievements:</H1>
            <ul>
                @foreach (var achievement in Model.achievements)
                {
                    <li>@achievement</li>
                }
            </ul>
            <H1>Projects: </H1>
            <ul>
                @foreach (var project in Model.projects)
                {
                    <li><a href="@project.Value">@project.Key</a></li>
                }
            </ul>
            <H1>Tech Stack:</H1>
            <ul>
                @foreach (var tech in Model.techStack)
                {
                    <li>@tech</li>
                }
            </ul>
            <H1>Hobbies: </H1>
            <ul>
                @foreach (var hobby in Model.hobbies)
                {
                    <li>@hobby</li>
                }
            </ul>
        </div>
    </div>
</body>

</html>
