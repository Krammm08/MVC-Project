@model WebApplication1.Models.Portfolio
@{
    ViewData["Title"] = "Portfolio";
    ViewData["BodyClass"] = "portfolio-body";
}


<div class="portfolio-page">
    <div class="grid-container">
        <div class="left-container">
            <img src="@Model.profileImage" alt="Profile Image" class="profile-image" />
            <p class="name">@Model.firstName @Model.lastName</p>
            <p class="description">Computer Science Student</p>
            <p class="tagline">"CS student. Gamer. Data enthusiast."</p>
            <hr />
            <ul>
                @for (int i = 0; i < Math.Min(Model.information.Count, Model.informationImage.Count); i++)
                {
                    <li>
                        <img src="@Model.informationImage[i]" alt="Information" />
                        @Model.information[i]
                    </li>
                }
            </ul>
            <hr />
            <h1 class="header">Tech Stack:</h1>
            <div class="tech">
                <ul class="tech-stack">
                    @foreach (var tech in Model.techStack)
                    {
                        <img src="@tech" alt="techstack" class="techImage" />
                    }
                </ul>
            </div>
            <hr />
            <div class="socials">
                <ul class="social-media">
                    @foreach (var social in Model.socials)
                    {
                        <a href="@social.Value">
                            <img src="@social.Key" alt="Social Media" />
                        </a>
                    }
                </ul>
            </div>
        </div>
        <div class="right-container">
            <h1 class="header">About Me:</h1>
            <p class="aboutMe">@Model.aboutMe</p>

            <h1 class="header">Education:</h1>
            <ul>
                @foreach (var education in Model.education)
                {
                    <li>@education</li>
                }
            </ul>
            <h1 class="header">Achievements:</h1>
            <ul>
                @foreach (var achievement in Model.achievements)
                {
                    <li>@achievement</li>
                }
            </ul>
            <h1 class="header">Projects:</h1>
            <ul>
                @for (int i = 0; i < Math.Min(Model.projects.Count, Model.projectDescription.Count); i++)
                {
                    <li>
                        <a href="@Model.projects.ElementAt(i).Value"
                           class="project-link">@Model.projects.ElementAt(i).Key</a>
                        @Model.projectDescription[i]
                    </li>
                }
            </ul>

            <h1 class="header">Hobbies:</h1>
            <ul>
                @foreach (var hobby in Model.hobbies)
                {
                    <li>@hobby</li>
                }
            </ul>
        </div>
    </div>
</div>